# Path to the markdown notes vault
# Can be an absolute path like D:/vault or /home/user/notes
NOTES_VAULT_PATH=D:/vault

# Log level for the MCP server (debug, info, warn, error)
LOG_LEVEL=info

# File watching interval in milliseconds (for detecting external changes)
# Set to 0 to disable file watching
NOTES_WATCH_INTERVAL=5000

# HTTP mode (multi-device sync) — set to true to enable HTTP transport alongside stdio
# QUILL_HTTP_ENABLED=false

# HTTP server port (default: 3000)
# QUILL_HTTP_PORT=3000

# HTTP server bind address (default: 127.0.0.1 for security)
# QUILL_HTTP_HOST=127.0.0.1

# Bearer token for HTTP authentication (recommended for non-localhost access)
# QUILL_AUTH_TOKEN=your-secret-token
